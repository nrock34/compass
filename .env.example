# Application cryptographic values: generate independent, high-entropy values per environment.
HOST=0.0.0.0
PORT=1337
# Compose uses STRAPI_PORT for the host mapping so unrelated host PORT values cannot change it.
STRAPI_PORT=1337
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# The new Strapi service has its own PostgreSQL database/schema; never use the Django application database.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
# `make dev` runs Strapi on the host; Compose exposes its isolated PostgreSQL service here.
DATABASE_PORT=54325
DATABASE_NAME=rwm_strapi
DATABASE_USERNAME=rwm_strapi
DATABASE_PASSWORD=change-me

# Docker Compose uses this namespace so an unrelated DATABASE_* shell variable
# cannot attach this isolated Strapi stack to another application's database.
STRAPI_DATABASE_NAME=rwm_strapi
STRAPI_DATABASE_USERNAME=rwm_strapi
STRAPI_DATABASE_PASSWORD=change-me
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_FORCE_MIGRATION=false

# Anonymous REST response cache. Redis keys are namespaced because startup
# invalidation must never flush sessions or another application's data.
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6380
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_KEY_PREFIX=rwm:strapi-cache:
CACHE_TTL_MS=120000
# Per-entity TTL classes. Mixed GraphQL operations use the shortest class TTL.
CACHE_TTL_STATIC_MS=7200000
CACHE_TTL_EDITORIAL_MS=1800000
CACHE_TTL_TIME_SENSITIVE_MS=300000
CACHE_TTL_DYNAMIC_MS=30000
CACHE_GET_TIMEOUT_MS=250
CACHE_DEBUG=false

# Browser/API boundary. Every frontend origin must be listed: strapi-cache
# intentionally skips storing GraphQL responses for unapproved origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false
PROXY_IP_HEADER=X-Forwarded-For
PROXY_MAX_IPS_COUNT=1
CRON_ENABLED=true

# S3-compatible upload provider. `make dev` supplies MinIO defaults; production
# supplies R2 values through either these generic variables or the R2 fallback.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE=
S3_REGION=
S3_FORCE_PATH_STYLE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=rwm-minio
MINIO_SECRET_KEY=rwm-minio-local-password

R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=

# Users & Permissions refresh-mode sessions.
UP_ACCESS_TOKEN_LIFESPAN=900
UP_MAX_REFRESH_TOKEN_LIFESPAN=604800
UP_IDLE_REFRESH_TOKEN_LIFESPAN=1209600
UP_MAX_SESSION_LIFESPAN=604800
UP_IDLE_SESSION_LIFESPAN=7200
UP_COOKIE_NAME=rwm_refresh
UP_COOKIE_SECURE=false
UP_COOKIE_SAME_SITE=lax

# Experimental multi-role Content API permissions (upstream alpha).
API_PERMISSIONS_ENABLED=false

# Shared PostgreSQL rate-limit controls. Values are request counts per named window.
RATE_LIMIT_LOGIN_IP_PER_MINUTE=15
RATE_LIMIT_LOGIN_ACCOUNT_PER_10_MINUTES=5
RATE_LIMIT_RESET_IP_PER_HOUR=10
RATE_LIMIT_RESET_ACCOUNT_PER_HOUR=3
RATE_LIMIT_MEMBER_MUTATIONS_PER_MINUTE=30
RATE_LIMIT_COMMUNITY_MUTATIONS_PER_MINUTE=20
RATE_LIMIT_GENERIC_MUTATIONS_PER_MINUTE=60
CATALOG_EDITOR_ENABLED=false
# Absolute public origin for provider recovery links and same-origin checks.
CATALOG_EDITOR_PUBLIC_ORIGIN=http://localhost:1337
