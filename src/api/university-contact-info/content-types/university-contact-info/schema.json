    "city": {"type": "string", "default": "", "maxLength": 120},
    "state_code": {"type": "string", "default": "", "maxLength": 16},
    "country_code": {"type": "string", "default": "", "maxLength": 8},
    "country_name": {"type": "string", "default": "", "maxLength": 255},
    "zip_code": {"type": "string", "default": "", "maxLength": 20},
    "university": {
