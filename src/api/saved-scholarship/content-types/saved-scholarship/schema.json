{
  "kind": "collectionType",
  "collectionName": "members_savedscholarship",
  "info": {
    "singularName": "saved-scholarship",
    "pluralName": "saved-scholarships",
    "displayName": "Saved scholarship"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "useJoinTable": false,
      "target": "plugin::users-permissions.user",
      "inversedBy": "saved_scholarships",
      "required": true
    },
    "scholarship": {
      "type": "relation",
      "relation": "manyToOne",
      "useJoinTable": false,
      "target": "api::scholarship.scholarship",
      "inversedBy": "saved_by_users",
      "required": true
    },
    "position": { "type": "integer", "required": true, "default": 0, "min": 0 },
    "saved_at": {"type": "datetime", "required": true, "visible": false}
  }
}
