{
  "kind": "collectionType",
  "collectionName": "catalog_programrequirements",
  "info": {
    "singularName": "program-requirement",
    "pluralName": "program-requirements",
    "displayName": "Program requirements"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "program": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::program.program",
      "inversedBy": "requirements"
    },
    "gpa": { "type": "string", "required": true, "maxLength": 6 },
    "language": { "type": "string", "required": true, "maxLength": 20 },
    "prerequisites": { "type": "json", "required": true, "default": [] },
    "active_credits_needed": { "type": "integer", "required": true, "min": 0, "max": 32767, "default": 12 },
    "level": { "type": "string", "required": true, "default": "Undergraduate", "maxLength": 30 }
  }
}
