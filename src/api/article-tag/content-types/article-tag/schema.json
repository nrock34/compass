{
  "kind": "collectionType",
  "collectionName": "editorial_articletag",
  "info": {
    "singularName": "article-tag",
    "pluralName": "article-tags",
    "displayName": "Article Tag"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 48
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "tags",
      "visible": false
    }
  }
}
