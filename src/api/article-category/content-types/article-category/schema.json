{
  "kind": "collectionType",
  "collectionName": "editorial_articlecategory",
  "info": {
    "singularName": "article-category",
    "pluralName": "article-categories",
    "displayName": "Article Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 48
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "category",
      "visible": false
    }
  }
}
