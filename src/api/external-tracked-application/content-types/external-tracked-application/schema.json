    "link": { "type": "string", "required": true, "maxLength": 200 },
    "user_apps": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::tracked-application.tracked-application",
      "mappedBy": "for_external",
      "visible": false
    }
  }
