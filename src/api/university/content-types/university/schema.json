{
  "kind": "collectionType",
  "collectionName": "catalog_university",
  "info": {
    "singularName": "university",
    "pluralName": "universities",
    "displayName": "University"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": { "type": "string", "required": true, "unique": true, "maxLength": 255 },
    "size": { "type": "integer", "required": true },
    "country": { "type": "string", "required": true, "maxLength": 255 },
    "state": { "type": "string", "required": true, "maxLength": 125 },
    "description": { "type": "text", "maxLength": 800 },
    "founded": { "type": "integer", "min": 0, "max": 32767 },
    "accreditation": { "type": "string", "maxLength": 70 },
    "has_study_abroad": { "type": "boolean", "required": true, "default": false },
    "contact_info": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::university-contact-info.university-contact-info",
      "inversedBy": "university"
    },
    "location": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::university-location.university-location",
      "inversedBy": "university"
    },
    "social_media_links": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::university-social-media-link.university-social-media-link",
      "inversedBy": "university"
    },
    "school_urls": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::university-school-url.university-school-url",
      "inversedBy": "university"
    },
    "academic_stats": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::university-academic-stat.university-academic-stat",
      "inversedBy": "university"
    },
    "campus_life": {
      "type": "relation",
      "relation": "oneToOne",
      "useJoinTable": false,
      "target": "api::university-campus-life.university-campus-life",
      "inversedBy": "university"
    },
    "date_created": {"type": "datetime", "required": true, "visible": false},
    "provider_set": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::provider.provider",
      "mappedBy": "university",
      "visible": false
    },
    "students": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-education-info.user-education-info",
      "mappedBy": "university",
      "visible": false
    }
  }
}
